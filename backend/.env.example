# 复制为 backend/.env；不要覆盖已有密钥。完整安装与字段说明见根目录 README.md。
# 不配置外部 API 也可以注册、登录和管理角色；AI/语音需对应服务配置。
# 旧版共享字段：DeepSeek文字 + 阿里云语音时留空，使用下方独立字段。
API_KEY=
API_BASE=
WSS_URL=

# 文字服务：AI_API_KEY、AI_BASE_URL、AI_MODEL三项必填才能启用聊天。
# DeepSeek基础地址：https://api.deepseek.com；模型以账号当前可用名称为准。
# 密钥和基础地址为空时分别回退 API_KEY / API_BASE；AI_MODEL无默认值。
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_ENABLE_TOOLS=true

# 语音服务：使用兼容DashScope任务协议的WebSocket，独立于文字供应商。
# ASR为语音识别，TTS为语音合成；各自密钥/地址回退 API_KEY / WSS_URL。
# 北京业务空间示例：wss://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# 替换真实WorkspaceId；密钥、地址、地域与模型必须匹配，官方链接见README。
ASR_API_KEY=
ASR_WSS_URL=
ASR_MODEL=fun-asr-realtime
TTS_API_KEY=
TTS_WSS_URL=
TTS_MODEL=cosyvoice-v3-flash

# 自动记忆默认关闭；手动记忆仍可用。模型留空复用AI_MODEL，启用后需run_jobs。
MEMORY_MODEL=
MEMORY_AUTO_UPDATE=false
# 保持旧共享演示知识表关闭；不影响现有隔离的角色知识文件功能。
ENABLE_LEGACY_KNOWLEDGE=false

# 个人音色复刻额外配置：使用与TTS匹配的账号、地域及模型；普通预设音色不需要。
# 北京业务空间示例：https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/customization
VOICE_URL=
# 本应用公网HTTPS根地址，供供应商获取30分钟签名样本；不能填localhost或AI接口。
PUBLIC_BASE_URL=

# 下方为本地HTTP开发默认值；生产改DEBUG=false、强密钥及实际域名/来源白名单。
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=false

# 可选OpenAI兼容嵌入服务：三项一起配置；留空使用本地关键词检索。
# 不复用文字聊天配置；模型必须支持embeddings，索引任务需run_jobs。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 可选公开角色审核：true时由staff在Django admin批准/拒绝。
REQUIRE_CHARACTER_REVIEW=false
