# Copy to .env and configure your provider credentials to enable AI and voice.
API_KEY=
API_BASE=
WSS_URL=

# Text provider (OpenAI-compatible). AI_MODEL must match your provider/account.
# AI_API_KEY and AI_BASE_URL fall back to API_KEY and API_BASE above.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_ENABLE_TOOLS=true

# Voice WebSocket protocol is DashScope-compatible; configure separately.
# Independent keys/URLs fall back to API_KEY / WSS_URL for legacy installs.
ASR_API_KEY=
ASR_WSS_URL=
ASR_MODEL=fun-asr-realtime
TTS_API_KEY=
TTS_WSS_URL=
TTS_MODEL=cosyvoice-v3-flash

# Automatic memory summarization is opt-in. Manual memory remains available.
MEMORY_MODEL=
MEMORY_AUTO_UPDATE=false
# Keep the shared demo knowledge table disabled until resource isolation exists.
ENABLE_LEGACY_KNOWLEDGE=false

# Custom voice enrollment (independent from text AI). Same region/account as TTS.
# Beijing example: https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
VOICE_URL=
# Public HTTPS URL of this app, required so provider can fetch a 30-minute signed sample.
PUBLIC_BASE_URL=

# Production environment; defaults below are for local development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=false

# Optional OpenAI-compatible embeddings. Leave empty for local keyword retrieval.
# Configure an embedding provider separately; text chat configuration is not reused.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Optional public-role review queue; staff approves/rejects in Django admin.
REQUIRE_CHARACTER_REVIEW=false
