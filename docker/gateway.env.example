# Compose variables only. API credentials and DJANGO_SECRET_KEY go in backend/.env.
APP_DOMAIN=ai.example.com
# Each project on this host needs a different loopback port.
APP_HTTP_PORT=8080
APP_DEBUG=false
APP_TRUST_PROXY=true
APP_ORIGIN=https://ai.example.com
NGINX_TEMPLATE=./docker/nginx.gateway.conf.template
